# Loopa Technology: static site on GoDaddy (Apache/LiteSpeed, cPanel).
# The build writes /ruta.html files; these rules serve them at clean URLs like Vercel's cleanUrls.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
# /blog and /blog.html sit next to a /blog/ folder; without this Apache would redirect /blog to /blog/.
DirectorySlash Off

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. HTTPS and no www, in one hop.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://loopa.technology%{REQUEST_URI} [L,R=301,NE]

# 2. Old WordPress URLs (site before 2026-11). Each goes to its closest new page.
RewriteRule ^(en/)?terms-and-conditions/?$ /$1terminos [L,R=301]
RewriteRule ^(en/)?privacy-policy/?$ /$1privacidad [L,R=301]
RewriteRule ^en/legal/?$ /en/privacidad [L,R=301]
RewriteRule ^legal/?$ /privacidad [L,R=301]
# Posts (/2023/07/slug/), categories, tags, author pages and feeds: to the blog.
RewriteRule ^(en/)?20[0-9]{2}/[0-9]{2}/[^/]+/?$ /$1blog [L,R=301]
RewriteRule ^(en/)?(category|tag|author)/ /$1blog [L,R=301]
RewriteRule ^(en/)?(blog/)?feed/?$ /$1blog [L,R=301]
RewriteRule ^(en/)?wp-sitemap.*\.xml$ /sitemap.xml [L,R=301]
RewriteRule ^(en/)?(home|home-3|inicio)/?$ /$1 [L,R=301]
# WordPress system paths no longer exist: answer 410 Gone so bots drop them fast.
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/|$) - [G,L]
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php)$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat)=[0-9]+ [NC]
RewriteRule ^ /? [L,R=301]

# 3. Trailing slash off (/blog/ -> /blog), except the root.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 4. /ruta.html -> /ruta, so every page has one URL.
RewriteCond %{THE_REQUEST} \s/([^\s?]*?)(index)?\.html[\s?]
RewriteRule ^ /%1 [L,R=301]

# 5. Serve /ruta from /ruta.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

# Hashed files in /assets never change: cache for a year.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
